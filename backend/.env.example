# Backend Environment Variables Template for Render
PORT=4000
NODE_ENV=production

# Supabase / PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Secrets
ACCESS_TOKEN_SECRET=your_jwt_access_secret_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Allowed Frontend Origins (Comma separated for Vercel + Localhost)
CLIENT_ORIGIN=https://your-app.vercel.app,http://localhost:5173

# AI API Keys
GEMINI_API_KEY_1=your_gemini_api_key
GROK_API_KEY_1=your_grok_api_key
